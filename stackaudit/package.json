{
  "name": "stackaudit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --webpack",
    "dev:private-network": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/run-server.ts dev",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1",
    "start:private-network": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/run-server.ts start",
    "lint": "eslint",
    "test": "vitest run --exclude **/integration.test.ts",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --exclude **/integration.test.ts",
    "test:integration": "vitest run app/api/v1/usage/integration.test.ts core/audit/__tests__/integration.test.ts core/monitoring/__tests__/integration.test.ts core/outcomes/__tests__/integration.test.ts core/workloads/__tests__/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "pricing:load": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/load-pricing-fixtures.ts",
    "seed": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/seed-demo-data.ts",
    "seed:demo": "npm run seed",
    "seed:reset": "npm run seed",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "setup": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^2.8.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.105.3",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^20.19.40",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.1.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "license": "Apache-2.0"
}
