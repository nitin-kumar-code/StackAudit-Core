# Use values from `supabase status` after running `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The demo seed uses a dedicated, ownership-marked organization. The app's
# development-only auth fallback can use this fixed ID.
DEMO_ORG_ID=8a775c7f-e31c-8f9b-9000-000000000001

# Reproducible seed scenario. The date is the exclusive UTC end of the 90-day range.
DEMO_SEED=12345
DEMO_DATASET_DAYS=90
DEMO_DATASET_END=2026-10-17T00:00:00.000Z

# Remote seeding is refused unless both settings are deliberately provided.
DEMO_SEED_ALLOW_REMOTE=false
DEMO_SEED_EXPECTED_REMOTE_HOST=
