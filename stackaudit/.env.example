# StackAudit V0 — Single-User, Local-First Evidence Ledger
#
# IMPORTANT SECURITY NOTICE:
# StackAudit V0 is designed to run locally on an operator workstation or inside an
# isolated, explicitly controlled private network. It is NOT a public multi-tenant SaaS application.
# It does NOT provide user sessions, public registration, or cross-tenant RBAC.
# Never expose an unauthenticated V0 instance to the public internet.

# Deployment Security Mode:
# - 'local' (default): strictly enforces 127.0.0.1 loopback host binding and localhost database access.
# - 'private-network': allows deployment within an isolated, trusted private network (VPN/firewall).
#   Requires STACKAUDIT_ALLOW_PRIVATE_NETWORK=true acknowledgment.
STACKAUDIT_DEPLOYMENT_MODE=local

# Set to 'true' ONLY if STACKAUDIT_DEPLOYMENT_MODE=private-network is explicitly configured.
# STACKAUDIT_ALLOW_PRIVATE_NETWORK=false

# Database Security Mode:
# - 'local' (default): requires a localhost Supabase endpoint (e.g. 127.0.0.1:54321).
# - 'remote': deliberate operator override for an isolated external database.
STACKAUDIT_DATABASE_MODE=local

# Supabase API endpoint (from `supabase status` after `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Privileged Supabase service-role key (from `supabase status`).
# NEVER prefix with NEXT_PUBLIC_, never commit to Git, never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit Active Workspace Organization UUID.
# The server verifies this organization exists and scopes all queries to it.
# It never creates or selects an organization implicitly.
# The default demo seeder uses the UUID below.
STACKAUDIT_WORKSPACE_ORG_ID=8a775c7f-e31c-8f9b-9000-000000000001
# STACKAUDIT_ORG_ID is supported as an exact alias:
# STACKAUDIT_ORG_ID=8a775c7f-e31c-8f9b-9000-000000000001

# Reproducible seed scenario (deterministic synthetic dataset).
DEMO_SEED=12345
DEMO_DATASET_DAYS=90
# Leave DEMO_DATASET_END unset to end at current UTC midnight (recommended for live dashboard & alerts),
# or specify an explicit ISO date for deterministic historical replays (e.g. 2026-10-17T00:00:00.000Z).
# DEMO_DATASET_END=2026-10-17T00:00:00.000Z

# Optional internal secret for securing cron/monitoring endpoints:
# CRON_SECRET=

# Optional 64-hex-character key for encrypting webhook notification secrets:
# WEBHOOK_ENCRYPTION_KEY=
