# Use values from `supabase status` after running `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set after running `npm run seed`; development-only API fallback.
DEMO_ORG_ID=

# Optional: set to true only when deliberately seeding a remote demo database.
DEMO_SEED_ALLOW_REMOTE=false
